# =============================================================================
# OPTIONAL — local Docker test database ONLY (docker compose)
# =============================================================================
# Docker Compose treats $ in unquoted values as "start of variable". If your
# password contains $, either wrap the whole value in double quotes, e.g.
#   AGENT_USER_PASSWORD="my$secret"
# or escape each dollar as $$, e.g.
#   AGENT_USER_PASSWORD=my$$secret
#
# After fixing .env, if MySQL was already initialized with a wrong password,
# run: docker compose down -v && docker compose up -d
# Required for the official MySQL image (database name for init + your app).
MYSQL_DATABASE=db_agent_test

MYSQL_ROOT_PASSWORD=change-me-root-strong
AGENT_USER_PASSWORD=change-me-agent-strong
